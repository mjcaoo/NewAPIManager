{
  "name": "new-api-manager",
  "version": "0.1.3",
  "description": "Windows tray manager for the New API core service",
  "main": "src/main.js",
  "author": "mjcaoo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/utils/time.js && node --check src/services/core-manager.js && node --check src/services/update-service.js && node --check src/services/update-utils.js && node --check src/services/config-store.js && node --check src/services/backup-service.js && node --check src/renderer/app.js",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^39.8.5",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "io.local.newapimanager",
    "productName": "New API Manager",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "THIRD_PARTY_NOTICE.md"
    ],
    "extraFiles": [
      {
        "from": "core",
        "to": "core",
        "filter": ["**/*"]
      },
      {
        "from": "config",
        "to": "config",
        "filter": ["manager.example.json", "new-api.env.example"]
      }
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": ["nsis", "portable"],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable-${arch}.${ext}"
    }
  }
}
